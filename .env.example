# Frontend build-time settings. Empty API URL selects daily challenges locally.
# Public URL including base path, used for absolute social preview image URLs.
# GitHub Pages supplies this automatically in CI. Set for other hosting targets.
SITE_URL=https://digital-landscape.at/AlpTap/
# Optional: set an API origin to use the legacy Node selection service.
VITE_API_URL=
VITE_SATELLITE_URL=https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-2024_3857/default/g/{z}/{y}/{x}.jpg
VITE_SATELLITE_MAX_ZOOM=14
# VITE_SATELLITE_ATTRIBUTION=Required provider attribution HTML
VITE_TERRAIN_ENABLED=true
VITE_TERRAIN_EXAGGERATION=1.5
VITE_DEM_URL=https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png
VITE_DEM_ENCODING=terrarium
VITE_DEM_MAX_ZOOM=14
# VITE_DEM_ATTRIBUTION=Required elevation provider attribution HTML
# Relief basemap: EOX water overlay, rendered over hillshade from the DEM above.
VITE_HYDROGRAPHY_URL=https://tiles.maps.eox.at/wmts/1.0.0/hydrography_3857/default/g/{z}/{y}/{x}.png
VITE_HYDROGRAPHY_MAX_ZOOM=14
# VITE_HYDROGRAPHY_ATTRIBUTION=Required water provider attribution HTML
# OpenMapTiles-compatible vector source; only water/class=ocean is displayed.
VITE_OCEAN_URL=https://tiles.openfreemap.org/planet
# API settings are process environment variables, not Vite settings:
# HOST=0.0.0.0 PORT=8787 CORS_ORIGINS=https://play.example.org
# DATA_INDEX=data/processed/api-index.json
# CURATED_FILE=data/config/curated.json
